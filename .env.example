# Freshsales CRM credentials (required)
FRESHSALES_DOMAIN=yourcompany.myfreshworks.com
FRESHSALES_API_KEY=your_freshsales_api_key_here

# MCP server security
# Generate a strong random token: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave blank to disable auth (local dev only)
MCP_AUTH_TOKEN=your_secret_bearer_token_here

# CORS — comma-separated allowed origins. Use * only for testing.
ALLOWED_ORIGINS=*

# Local development port
PORT=8000
